rules_version = '2';

/**
 * gekokujo-online Firestoreセキュリティルール
 *
 * firebase-kit設計思想に準拠:
 * - クライアントからFirestoreへの直アクセスを全面禁止
 * - 全てのデータ操作はCloud Functions（Admin SDK）経由で行う
 * - Admin SDKはセキュリティルールをバイパスするため、Functionsからのアクセスは許可される
 *
 * 対象コレクション:
 * - sessions: セッション情報（ブラウザ環境 + playLog）
 * - scores: スコア記録（上限10000件、定期cleanup）
 * - rankSnapshots: ランキング閾値スナップショット
 */

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
